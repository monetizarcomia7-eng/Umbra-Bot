# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase database (optional — for direct DB access via Prisma/Drizzle)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres

# Application URL (used to register Telegram webhooks)
APP_URL=https://yourdomain.com

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=APP_USR-xxxxxxxx
# Webhook signing secret (configure on MP dashboard → Webhooks)
MERCADOPAGO_WEBHOOK_SECRET=your-mp-webhook-secret

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=Bxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VAPID_EMAIL=admin@yourdomain.com

# Upstash Redis — rate limiting distribuído (funciona em multi-instância serverless)
# Crie grátis em https://console.upstash.com → New Database → REST API
# Sem essas variáveis, o rate limit usa memória local (inadequado para produção)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXXXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Admin e-mail — only this user can access /api/migrations
ADMIN_EMAIL=admin@yourdomain.com

# Sentry (error monitoring — free up to 5k errors/month)
NEXT_PUBLIC_SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx
SENTRY_ORG=your-org
SENTRY_PROJECT=umbra-bot
SENTRY_AUTH_TOKEN=sntrys_xxx  # optional, needed only for source map upload

# PostHog (product analytics — free up to 1M events/month)
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Supabase Management API (optional — needed for /api/migrations runner)
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_REF=your-project-ref
